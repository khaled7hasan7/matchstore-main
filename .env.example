APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matchstore
DB_USERNAME=root
DB_PASSWORD=

# --- Supabase (PostgreSQL) ---
# Copy these from Supabase -> Connect -> Session pooler (IPv4, port 5432).
# Do NOT use the Transaction pooler (6543): it breaks Laravel's prepared
# statements. The username is postgres.<project-ref>, not plain "postgres".
#
# IMPORTANT: with the separate variables below the password goes in RAW.
# Supabase's "percent-encode special characters" note applies only to the
# single connection-string form — encoding it here fails authentication.
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database-password>
# DB_SSLMODE=require
#
# Alternative: one connection string instead of the six variables above.
# Here the password MUST be percent-encoded (@ -> %40, : -> %3A, / -> %2F).
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://postgres.<project-ref>:<encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Storage (uploads) ---
# The serverless host's filesystem is read-only, so a product photo uploaded
# from the admin panel has nowhere to go without this. Set it and every upload
# in the application switches to the bucket — no other change needed.
#
# Create a bucket in Supabase -> Storage, mark it Public, then take the
# service_role key from Settings -> API. That key can write to every bucket,
# so keep it out of the repository and out of the browser.
# SUPABASE_STORAGE_BUCKET=falak
# SUPABASE_STORAGE_KEY=<service_role-key>
# SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1
#
# Check it, and optionally copy the shipped catalogue artwork up:
#   php artisan falak:storage
#   php artisan falak:storage --push

# --- Vercel deployment ---
# The build runs scripts/vercel-build.sh, which migrates and seeds on every
# deploy — the database lives outside the deployment, so pushing code alone
# never changes what the shop displays.
#
# Set these two and the deploy also creates the dashboard account. Choose the
# password yourself; nothing generates or prints one into the build log.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=<a password you choose>
#
# Optional: /__status reports the commit, the database and the row counts.
# With this set, ?token=<value> additionally shows the host and database name.
# STATUS_TOKEN=<any long random string>
